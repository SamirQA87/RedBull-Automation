{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript regression tests (API and UI) for the Devices app",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:stable": "playwright test --grep-invert @known-bug",
    "test:known-bugs": "playwright test --grep @known-bug",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "Samir Rizvanovic",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.4",
    "typescript": "^5.6.0"
  }
}
